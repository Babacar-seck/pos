# Copy to `.secrets` and fill in local/server-only values. Never commit `.secrets`.
# Loaded by `./run.sh` and `scripts/deploy-amvara9.sh` as an extra docker compose `--env-file`
# (after `config.env`). Already gitignored.

# GitHub tokens (optional — gh CLI keyring also works)
# GH_TOKEN=
# GITHUB_TOKEN=
# MARKETING_ARTIFACT_TOKEN=

# Google Analytics 4 measurement ID (gtag). Injected into the Angular index.html at
# container start via GOOGLE_ANALYTICS_MEASUREMENT_ID. Leave unset to disable tracking.
# GOOGLE_ANALYTICS_MEASUREMENT_ID=G-XXXXXXXXXX
